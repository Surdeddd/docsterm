  "author": "Surdeddd",
  "homepage": "https://github.com/Surdeddd/docsterm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Surdeddd/docsterm.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Surdeddd/docsterm/issues"
  },
