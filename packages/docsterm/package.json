{
  "name": "docsterm",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Embeddable AI terminal for documentation: a live in-browser console with an AI command assistant",
  "keywords": [
    "documentation",
    "terminal",
    "xterm",
    "ai",
    "interactive-tutorial",
    "docs",
    "pyodide"
  ],
  "author": "Surdeddd (https://github.com/Surdeddd)",
  "homepage": "https://docsterm.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Surdeddd/docsterm.git"
  },
  "bugs": {
    "url": "https://github.com/Surdeddd/docsterm/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "default": "./dist/mock/index.js"
    },
    "./pyodide": {
      "types": "./dist/pyodide/index.d.ts",
      "default": "./dist/pyodide/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic/index.d.ts",
      "default": "./dist/anthropic/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.60.0",
    "pyodide": ">=0.26.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "pyodide": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "pyodide": "314.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
