{
  "name": "docsterm",
  "version": "0.8.0",
  "type": "module",
  "license": "MIT",
  "description": "Embeddable AI terminal for documentation: a live in-browser console with an AI command assistant",
  "keywords": [
    "documentation",
    "terminal",
    "xterm",
    "ai",
    "interactive-tutorial",
    "docs",
    "pyodide",
    "openai",
    "openrouter",
    "ollama",
    "llm",
    "shell",
    "repl",
    "sandbox",
    "websocket",
    "javascript",
    "wasi",
    "wasm",
    "rust"
  ],
  "author": "Surdeddd (https://github.com/Surdeddd)",
  "homepage": "https://docsterm.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Surdeddd/docsterm.git",
    "directory": "packages/docsterm"
  },
  "bugs": {
    "url": "https://github.com/Surdeddd/docsterm/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "./dist/index.d.ts"
      ],
      "*": [
        "./dist/*/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "default": "./dist/shell/index.js"
    },
    "./javascript": {
      "types": "./dist/javascript/index.d.ts",
      "default": "./dist/javascript/index.js"
    },
    "./pyodide": {
      "types": "./dist/pyodide/index.d.ts",
      "default": "./dist/pyodide/index.js"
    },
    "./wasi": {
      "types": "./dist/wasi/index.d.ts",
      "default": "./dist/wasi/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "default": "./dist/websocket/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "default": "./dist/mock/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic/index.d.ts",
      "default": "./dist/anthropic/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node -e \"require('node:fs').rmSync('.dist-next',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --outDir .dist-next && node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.renameSync('.dist-next','dist')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build && node ../../scripts/sync-readme.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.18.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.50.1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/headless": "^6.0.0",
    "pyodide": "314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
