{
  "name": "docsterm-monorepo",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "build": "pnpm --filter docsterm run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint packages/docsterm/src packages/docsterm/test demo/src e2e scripts examples",
    "test": "vitest run",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "coverage": "vitest run --coverage",
    "probe": "pnpm run build && node scripts/pack-probe.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
